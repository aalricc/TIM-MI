flowchart LR
  %% ==============================================================
  %% MI Agent - Final Deliverable Architecture
  %% RL-driven Autonomous Recovery for Failed Systems
  %% ==============================================================

  classDef plane fill:#0b3b5a,stroke:#07293f,color:#ffffff,stroke-width:1px;
  classDef core fill:#145f9e,stroke:#0d426e,color:#ffffff,stroke-width:1px;
  classDef rl fill:#7b2cbf,stroke:#53207f,color:#ffffff,stroke-width:1px;
  classDef safety fill:#b02a37,stroke:#7d1e27,color:#ffffff,stroke-width:1px;
  classDef data fill:#2b8a3e,stroke:#1e5f2b,color:#ffffff,stroke-width:1px;
  classDef ext fill:#6c757d,stroke:#495057,color:#ffffff,stroke-width:1px;

  %% ------------------------------
  %% External systems and operators
  %% ------------------------------
  SRE[SRE / On-call Engineer]:::ext
  UI[MI API + Dashboard\n(FastAPI + SSE)]:::plane
  TARGET[Failed Service\n(SQLite-backed target system)]:::ext
  LLM[LLM Provider\n(OpenAI/Azure Responses API)]:::ext
  RESTORE[Last-Resort Restore\nHTTP service or local restorer]:::ext

  %% ------------------------------
  %% MI AGENT control loop
  %% ------------------------------
  subgraph MIAGENT[MI AGENT: Online Self-Healing Control Loop]
    MON[Monitor + Incident Trigger\nagent/monitor.py]:::core
    SUP[Incident Supervisor\nlock/backoff/attempt caps/hour caps\nsupervisor/supervisor.py]:::core
    OBS[Observation + Fingerprint Builder\nlogs, probes, agent state\nagent/diagnose.py]:::core
    PLAN[Planner\nTyped candidate plans\nagent/agent.py]:::core
    EXEC[Tool Executor\nallowlisted primitives + schema checks\nsnapshots/rollback\ntools/executor.py]:::core
    VER[Independent Verifier\nhealth/connectivity/integrity/schema/RW\nverifier/verifier.py]:::core
  end

  %% ------------------------------
  %% RL decisioning and learning
  %% ------------------------------
  subgraph RLCORE[RL Decision & Learning Core]
    FEAT[State Representation\nfailure_type + fingerprints + context]:::rl
    BANDIT[Policy Selector\nEpsilon-greedy contextual bandit\nagent/selector.py]:::rl
    VALUE[Policy Store\nQ-like action values + recency weighting\npolicy/store.py]:::rl
    SKILLS[Skill Memory\nretrieval/match/lifecycle\nskills/library.py + skills/matcher.py]:::rl
    DISTILL[Skill Distillation\nconvert successful traces to reusable skills\nskills/distiller.py]:::rl
    REWARD[Reward Engine\nresolution reward + penalties\n(rollback/escalation/cap/time)]:::rl
  end

  %% ------------------------------
  %% Safety and governance boundary
  %% ------------------------------
  subgraph SAFETY[Safety, Guardrails, and Governance]
    SHIELD[Candidate Shield\nreject unsafe/invalid/unexecutable steps]:::safety
    PATHGUARD[Path Guard\nsandbox root enforcement\nbackup traversal/symlink denial]:::safety
    GATE[Verifier-Only Success Gate\nagent cannot self-declare recovery]:::safety
    ESCALATE[Escalation + Operator Handoff\nwhen confidence low or caps reached]:::safety
  end

  %% ------------------------------
  %% Persistent state and telemetry
  %% ------------------------------
  subgraph PERSIST[Persistent MI AGENT State]
    POLICY[(state/policy_store.json)]:::data
    SKILLDB[(state/skills.md)]:::data
    DECISIONS[(state/decision_log.jsonl)]:::data
    EVENTS[(state/events.jsonl)]:::data
    TAXON[(state/failure_taxonomy.json)]:::data
  end

  %% ------------------------------
  %% Control-plane interactions
  %% ------------------------------
  SRE <--> UI
  UI --> MON

  %% ------------------------------
  %% End-to-end self-healing loop
  %% ------------------------------
  TARGET --> MON
  MON --> SUP
  SUP --> OBS
  OBS --> FEAT
  FEAT --> PLAN
  PLAN -. diagnostic/planning calls .-> LLM
  PLAN --> SHIELD
  SHIELD --> BANDIT
  BANDIT --> EXEC
  EXEC --> TARGET
  EXEC --> VER
  VER --> GATE
  GATE --> REWARD

  %% ------------------------------
  %% RL update loop (closed feedback)
  %% ------------------------------
  REWARD --> VALUE
  VALUE --> BANDIT
  OBS --> SKILLS
  SKILLS --> PLAN
  VER --> DISTILL
  DISTILL --> SKILLS

  %% ------------------------------
  %% Safety/fallback path
  %% ------------------------------
  EXEC --> PATHGUARD
  SUP --> ESCALATE
  ESCALATE --> RESTORE
  RESTORE --> TARGET
  ESCALATE --> SRE

  %% ------------------------------
  %% Persistence
  %% ------------------------------
  VALUE --> POLICY
  SKILLS --> SKILLDB
  BANDIT --> DECISIONS
  SUP --> EVENTS
  OBS --> TAXON
