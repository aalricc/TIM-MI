# Monitoring target app
MI_TARGET_SERVICE_URL=http://target-app:8080
MI_MONITOR_HEALTH_PATH=/health/deep
MI_LOGS_ENDPOINT_PATH=/ops/logs
MI_DB_STATUS_ENDPOINT_PATH=/ops/db/status
MI_MONITOR_INTERVAL_SECONDS=1
MI_REQUEST_TIMEOUT_SECONDS=5
TARGET_HEARTBEAT_INTERVAL_SECONDS=3

# Filesystem boundaries
MI_APP_ROOT=/target/app
MI_SANDBOX_ROOT=/target
MI_BACKUPS_ROOT=/target/backups
MI_DB_FILE=/target/app/data/app.db
MI_APP_LOG=/target/app/app.log
MI_SCHEMA_FILE=/target/app/schema.sql

# State persistence
MI_STATE_DIR=/state
MI_EVENT_LOG_PATH=/state/events.jsonl
MI_POLICY_STORE_PATH=/state/policy_store.json
MI_TOOL_CATALOG_PATH=/state/tool_catalog.json

# LLM runtime
MI_LLM_MODEL=gpt-5.3-codex
MI_LLM_ENDPOINT=https://api.openai.com/v1/responses
MI_LLM_TIMEOUT_SECONDS=20
MI_LLM_AUTH_MODE=bearer
MI_LLM_API_KEY_HEADER=api-key
OPENAI_API_KEY=required

# Jev decision layer (mandatory)
MI_JEV_ENABLED=true
JEV_API_KEY=required
MI_JEV_MODEL=jev-latest
MI_JEV_BASE_URL=
MI_JEV_TIMEOUT_SECONDS=8
MI_JEV_USABLE_THRESHOLD=0.65

# RAG (mandatory)
MI_RAG_ENABLED=true
PINECONE_API_KEY=required
PINECONE_INDEX_HOST=required
PINECONE_NAMESPACE=sqlite-docs

# Class memory fast path (optional; off keeps baseline behavior)
MI_CLASSMEM_ENABLED=false
MI_CLASSMEM_DEDUPE_ENABLED=true
MI_CLASSMEM_FASTPATH_ENABLED=true
MI_CLASSMEM_STORE_PATH=/state/class_store.json
MI_CLASSMEM_JOIN_THRESHOLD=0.82
MI_CLASSMEM_MARGIN_DELTA=0.08
MI_CLASSMEM_TAU_CONF=0.80
MI_CLASSMEM_N_MIN=3
MI_CLASSMEM_COOLDOWN_SECONDS=30
MI_CLASSMEM_EMBEDDING_DIM=96
