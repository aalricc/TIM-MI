{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mi-agent/harness/contracts/judge_verdict.schema.v1.json",
  "title": "JudgeVerdictV1",
  "description": "LLM judge verdict for one sampled incident packet.",
  "type": "object",
  "required": [
    "schema_version",
    "incident_id",
    "diagnosis_correct",
    "action_appropriate",
    "notes",
    "failed_checks",
    "rubric_version",
    "judge_model",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "action_appropriate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "failed_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "D1",
          "D2",
          "D3",
          "A1",
          "A2",
          "A3",
          "A4"
        ]
      },
      "uniqueItems": true
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "judge_model": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "verdict",
        "skip"
      ]
    },
    "skip_reason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verdict"
          }
        }
      },
      "then": {
        "properties": {
          "diagnosis_correct": {
            "type": "boolean"
          },
          "action_appropriate": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "skip"
          }
        }
      },
      "then": {
        "required": [
          "skip_reason"
        ],
        "properties": {
          "diagnosis_correct": {
            "type": "null"
          },
          "action_appropriate": {
            "type": "null"
          }
        }
      }
    }
  ]
}
