{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mi-agent/harness/contracts/sensor_result.schema.v1.json",
  "title": "SensorResultV1",
  "description": "Output of one harness sensor run (harness/sensors). Harness-produced; never written by the runtime.",
  "type": "object",
  "required": [
    "schema_version",
    "sensor_name",
    "lane",
    "sensor_type",
    "stage",
    "status",
    "severity",
    "message",
    "violations",
    "ts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "v1"},
    "sensor_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "lane": {"type": "string", "enum": ["maintainability", "architecture", "behavior"]},
    "sensor_type": {"type": "string", "enum": ["computational", "inferential", "human"]},
    "stage": {"type": "string", "enum": ["pre_commit", "ci", "continuous"]},
    "status": {"type": "string", "enum": ["pass", "fail", "skipped"]},
    "severity": {"type": "string", "enum": ["info", "warn", "error", "critical"]},
    "message": {"type": "string"},
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["incident_id", "detail"],
        "additionalProperties": false,
        "properties": {
          "incident_id": {"type": ["string", "null"]},
          "attempt": {"type": ["integer", "null"]},
          "detail": {"type": "string"}
        }
      }
    },
    "checked": {
      "description": "Number of units examined (incidents, attempts, ...).",
      "type": "integer",
      "minimum": 0
    },
    "ts": {"type": "number"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "fail"}}},
      "then": {"properties": {"violations": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "pass"}}},
      "then": {"properties": {"violations": {"maxItems": 0}}}
    }
  ]
}
