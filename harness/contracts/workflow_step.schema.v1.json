{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mi-agent/harness/contracts/workflow_step.schema.v1.json",
  "title": "WorkflowStepV1",
  "description": "Harness record for one runtime `workflow.step` event (RecoveryAgent._publish_workflow_step). Step-specific metadata fields from the runtime payload are carried through unchanged.",
  "type": "object",
  "required": [
    "schema_version",
    "ts",
    "incident_id",
    "attempt",
    "path_mode",
    "step",
    "status",
    "readme_step"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "v1"},
    "ts": {"type": "number"},
    "incident_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "path_mode": {
      "type": "string",
      "enum": ["monitor", "class_memory", "fast_path", "full_loop"]
    },
    "step": {
      "type": "string",
      "enum": [
        "monitor.unhealthy_detected",
        "context.reused",
        "diagnostics.collected",
        "rag.symptom",
        "llm.why",
        "class_memory.lookup",
        "path.selected",
        "path.fallback",
        "rag.repair",
        "llm.how",
        "jev.requested",
        "jev.result",
        "security.gate",
        "dynamic_tool.registered",
        "dynamic_tool.executed",
        "verification.result",
        "persist.tool_catalog",
        "persist.policy_store",
        "persist.skills",
        "persist.class_memory",
        "post_recovery.ping",
        "attempt.result"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "disabled",
        "empty",
        "error",
        "failed",
        "failure",
        "fallback",
        "healthy",
        "ok",
        "recovered",
        "rejected",
        "retry",
        "skipped",
        "started",
        "unhealthy",
        "unusable",
        "usable"
      ]
    },
    "readme_step": {
      "description": "README.md loop step (1-16) this runtime step belongs to; null for markers outside the numbered loop (post_recovery.ping, attempt.result).",
      "anyOf": [
        {"type": "integer", "minimum": 1, "maximum": 16},
        {"type": "null"}
      ]
    }
  }
}
